rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todas las ESCRITURAS pasan por el servidor (Firebase Admin SDK, que ignora estas reglas).
    // Desde el navegador solo se permite leer lo estrictamente necesario.

    function signedIn() {
      return request.auth != null;
    }

    function isFounder() {
      return signedIn() && request.auth.token.email == 'pablofgarciaf@gmail.com';
    }

    function isStaff() {
      return isFounder() || (
        signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['super', 'admin', 'financial', 'sales']
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.active != false
      );
    }

    // Usuario (username) del afiliado autenticado.
    function myUsername() {
      return get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.username;
    }

    // Contenido público del sitio. `affiliate` (reglas del plan) solo para usuarios con sesión.
    match /siteContent/{docId} {
      allow read: if docId == 'main' || signedIn();
      allow write: if false;
    }

    match /leads/{leadId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Pedidos: contienen datos personales del cliente → solo personal autorizado.
    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /usuarios/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /userIndex/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Afiliados: el propio perfil, su red directa (hijos y nietos) y el personal.
    match /affiliates/{username} {
      allow read: if isStaff()
        || (signedIn() && resource.data.authUid == request.auth.uid)
        || (signedIn() && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
            && (resource.data.parentId == myUsername() || resource.data.granId == myUsername()));
      allow write: if false;
    }

    match /affiliate_commissions/{id} {
      allow read: if isStaff()
        || (signedIn() && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
            && resource.data.affiliateUsername == myUsername());
      allow write: if false;
    }

    match /affiliate_withdrawals/{id} {
      allow read: if isStaff()
        || (signedIn() && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
            && resource.data.affiliateUsername == myUsername());
      allow write: if false;
    }

    match /affiliateClicks/{id} {
      allow read: if isStaff()
        || (signedIn() && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
            && resource.data.username == myUsername());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
